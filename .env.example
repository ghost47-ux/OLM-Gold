# Copy to .env and fill in. NEVER commit .env.
TWELVE_DATA_API_KEY_1=
TWELVE_DATA_API_KEY_2=
TWELVE_DATA_API_KEY_3=
TWELVE_DATA_API_KEY_4=
TWELVE_DATA_API_KEY_5=
TWELVE_DATA_API_KEY_6=
TWELVE_DATA_API_KEY_7=

# Multi-account aggregate pooling is OFF unless explicitly authorized in writing.
TD_MULTI_ACCOUNT_POOL_AUTHORIZED=false

# Data-use authorization gates. Leave false until written permission exists.
TD_MODEL_TRAINING_APPROVED=false
TD_DATA_RETENTION_APPROVED=false
TD_COMMERCIAL_USE_APPROVED=false

# Conservative scheduling defaults.
TD_MAX_REQUESTS_PER_MINUTE=8
TD_SAFETY_MARGIN=0.20
TD_MAX_CONCURRENCY=2
